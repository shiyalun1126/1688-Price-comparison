# ========= LLM 配置（文字智能体 + 视觉匹配，统一走一个 OpenAI 兼容端点） =========
# 优先读 LLM_*，未配置时回退下方 DEEPSEEK_*；两者都没配则规则兜底（话术/解析/议价仍可用）
#
# 本地中转站示例（BuddySwitch 统一网关，多账号池轮询）：
#   LLM_BASE_URL=http://127.0.0.1:57892/v1
#   LLM_MODEL=wb-cn:deepseek-v4.1-flash    ← 模型名必须带命名空间前缀（wb-cn: / wb-global: / trae-cn: …）
#   LLM_API_KEY=sk-uni-xxxxxxxx            ← 在网关界面生成，明文只显示一次
#
# 公网厂商示例：
#   通义千问  LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   DeepSeek LLM_BASE_URL=https://api.deepseek.com                          LLM_MODEL=deepseek-chat
#   Kimi     LLM_BASE_URL=https://api.moonshot.cn/v1                         LLM_MODEL=kimi-k2-0905-preview
#   智谱     LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4               LLM_MODEL=glm-4.6
#   本地 Ollama LLM_BASE_URL=http://127.0.0.1:11434/v1                       LLM_MODEL=qwen3:14b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 视觉匹配单独指定模型（可选）：不填则跟随 LLM_MODEL。
# 文字用非多模态模型、图片另配多模态模型时才需要填
# LLM_VISION_MODEL=

# 输出预算（可选）。推理型模型先输出思维链再写正文，给小了会只返回空 content，
# 故默认给足：文字 1200、智能体每轮 2000；需要长文时再调大
# LLM_MAX_TOKENS=1200
# LLM_MAX_TOKENS_AGENT=2000

# 用量计费单价（元/百万 token，仅影响界面成本展示；按所配模型牌价填，留空则只显示 token 数）
LLM_INPUT_PRICE_PER_M=
LLM_OUTPUT_PRICE_PER_M=

# ========= DeepSeek 官方通道（回退用；配了 LLM_* 时不再读取） =========
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 视觉比对模型（可选；LLM_VISION_MODEL 未填时才用）
# DEEPSEEK_VISION_MODEL=deepseek-flash

# ========= 其他 =========
# 数据位置
DATA_DIR=./data
