# ========= LLM 通用配置（文字智能体，任意 OpenAI 兼容厂商） =========
# 优先读 LLM_*，未配置时回退下方 DEEPSEEK_*
# 通义千问示例：
#   LLM_API_KEY=sk-xxx
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-plus
# Kimi 示例：LLM_BASE_URL=https://api.moonshot.cn/v1  LLM_MODEL=kimi-k2-0905-preview
# 智谱示例：LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4     LLM_MODEL=glm-4.6
# 本地 Ollama：LLM_BASE_URL=http://127.0.0.1:11434/v1             LLM_MODEL=qwen3:14b
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 用量计费单价（元/百万 token，仅影响成本展示；按所配模型牌价填）
LLM_INPUT_PRICE_PER_M=
LLM_OUTPUT_PRICE_PER_M=

# ========= DeepSeek 配置（回退 + 视觉匹配专用） =========
# 视觉匹配走多模态模型 deepseek-flash，必须使用 DeepSeek 通道
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 视觉比对模型（可选；换用代理网关时可覆盖）
# DEEPSEEK_VISION_MODEL=deepseek-flash

# ========= 其他 =========
# 数据位置
DATA_DIR=./data
